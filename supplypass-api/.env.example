# Copie para .env. JWT_SECRET e DEMO_PASSWORD são obrigatórios.
PORT=3333
# Gere um valor único com pelo menos 32 caracteres e mantenha-o fora do Git.
JWT_SECRET=
# Senha local das contas de demonstração (mínimo de 10 caracteres).
DEMO_PASSWORD=
JWT_EXPIRES_IN=8h
ALERT_WINDOW_DAYS=30
MAX_UPLOAD_BYTES=10485760
# Chave AES-256 em hexadecimal (64 caracteres). Em desenvolvimento, se vazia,
# o servidor gera uma chave em data/file.key. Em produção, defina uma chave vinda
# de um cofre de segredos.
FILE_KEY=
