# Copie para .env e ajuste se precisar. Todos os valores têm padrão.
PORT=3333
# Required: generate a unique value and keep it out of Git.
JWT_SECRET=
# Required to seed the local demonstration accounts. Use a unique local value.
DEMO_PASSWORD=
JWT_EXPIRES_IN=8h
ALERT_WINDOW_DAYS=30
MAX_UPLOAD_BYTES=10485760
# Chave AES-256 em hexadecimal (64 caracteres). Se vazio, o servidor gera uma
# automaticamente em data/file.key na primeira execução.
FILE_KEY=
